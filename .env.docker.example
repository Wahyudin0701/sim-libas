# =============================================================================
# Konfigurasi Environment Khusus Docker SIM-LiBas RT 15
# Salin berkas ini ke .env saat menjalankan kontainer: cp .env.docker.example .env
# =============================================================================

APP_NAME="SIM-LiBas RT 15"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

# Port Web yang diekspos di Komputer / VPS (Akses: http://localhost:8080)
APP_PORT=8080

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Basis Data (Terhubung ke kontainer 'db' di jaringan internal Docker)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sim_libas
DB_USERNAME=sim_libas_user
DB_PASSWORD=rahasia_rt15
DB_ROOT_PASSWORD=root_rahasia_rt15

# Forward port DB (untuk DBeaver / Navicat dari laptop host)
DB_FORWARD_PORT=33066

# Sesi & Cache & Queue
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# Email (Konfigurasi jika memakai SMTP provider seperti Mailgun / Brevo)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@simlibas.id"
MAIL_FROM_NAME="${APP_NAME}"
